;[Ž€Ž’—ˆŠ ‚›‡Ž‚€ RST 8]
DOS2RST8	EX (SP),HL			;HL
		PUSH AF				;AF
		PUSH BC				;BC
		LD A,R
		JP PE,DOS2RST8_01
		LD A,R
DOS2RST8_01	DI
		PUSH AF				;RF
		PUSH HL				;ADR_RET
		PUSH DE				;DE
		IN A,(PEVO_CONF)
		LD L,A
		OR 1
		OUT (PEVO_CONF),A
		LD BC,RD_1WINA0
		IN A,(C)
		AND 0X3E
		LD BC,RD_1WINA0
		IN H,(C)
		RES 0,H
		LD B,HIGH (RD_DOS7FFD)
		IN E,(C)
		RES 4,E
		DEC B
		IN D,(C)
		LD BC,WIN_A0
		OUT (C),A
		LD B,HIGH (WIN_P0)
		XOR A
		JP ADR_SEL_ROM

EDOS2RST8	LD BC,DOS_NOEMUL
		LD A,(BC)
		AND 0X3E
		CP E
		JR Z,EDOS2RST02
		INC BC
EDOS2RST02	LD A,(BC)
		LD BC,WIN_A0
		CALL WR_BYTE_RET
		LD A,L
		OUT (PEVO_CONF),A
		POP DE
		POP HL
		POP AF
		JP PO,EDOS2RST01
		EI
EDOS2RST01	POP BC
		POP AF
		EX (SP),HL
		RET

;ABCDEFGHIJKLMNOPQRSTUVWXYZ
EXTEND_COM	
