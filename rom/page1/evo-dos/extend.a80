		LD (TRD_5D16),A			; ŠŽˆŸ	‘ˆ‘’…ŒŽƒŽ …ƒˆ‘’€ (Ž’ #FF)
		LD HL,ERR_OK
		PUSH HL
SET_CURRVIRT	LD H,CMOS.VIRT_REAL_DRIVE
		CALL READCMOS
		AND %00000011
		LD L,A
		LD A,B
		RLCA
		RLCA
		OR L
		LD L,A
		RST8D _CMOS_RW,_WRITE_CMOS
;		RST8D _MOUNTER,_GET_VIRT_BITS
;		RST30 _SET_VIRT_BITS
		RRCA
		RRCA
		AND 3
