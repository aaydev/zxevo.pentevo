
; LAST UPDATE: 11.02.2025 savelij

SUPPORT_EXT	DB "TRD"
		DB "SCL"
		DB "FDI"
		DB "TAP"
		DB "SPG"
		DB "$C "
		DB "FNT"
		DB "BMP"
		DB "ROM"
		DB 0

SYMS4SORT	DB ".!#$%&'()-0123456789@ABCDEFGHIJKLMNOPQRSTUVWXYZ^_`{}~",0x7F
		DB "АБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯЁ",0

; сортировка списка найденных директорий/файлов
SORT_FINDFILES	LD HL,(KOL_FOUNDED)
		LD A,H
		OR L
		RET Z				; выход если ничего не найдено
		DEC HL
		LD A,H
		OR L
		RET Z				; выход если директория/файл только 1
	EVOPORT WIN_P3,RAM_SORTFILES
		LD HL,CPU3+0x1000		; адрес первых символов
		LD DE,0x1000
		LD BC,SYMS4SORT
		EXX
		LD HL,CPU3+0x2000		; адрес куда складировать сортированное
		LD BC,(FATVAR.KOLFIND)
		EXX
; первый проход для директорий
SORTIR03	LD A,(HL)
		AND M_DIR_Directory
		JR Z,SORTIR01
		INC HL
		LD A,(BC)
		CP (HL)
		DEC HL
		JR NZ,SORTIR01
		SBC HL,DE			; переход к номерам
		LD A,(HL)
		INC HL
		EXX
		LD (HL),A
		INC HL
		EXX
		LD A,(HL)
		INC HL
		EXX
		LD (HL),A
		INC HL
		DEC BC
		LD A,B
		OR C
		EXX
		JR Z,SORTIR05			; если кончилось то тоже самое для файлов
		ADD HL,DE			; возврат к флагам и именам
		JR SORTIR03

; не директория, следующая пара
SORTIR01	INC HL
		INC HL
		EXX
		DEC BC
		LD A,B
		OR C
		EXX
		JR NZ,SORTIR03
SORTIR05	EXX
		LD BC,(FATVAR.KOLFIND)
		EXX
		LD HL,CPU3+0x1000
		INC BC
		LD A,(BC)
		AND A
		JR NZ,SORTIR03
		LD BC,SYMS4SORT
		LD HL,CPU3+0x1000
; второй проход для файлов
SORTIR02	LD A,(HL)
		AND M_DIR_Directory
		JR NZ,SORTIR04
		INC HL
		LD A,(BC)
		CP (HL)
		DEC HL
		JR NZ,SORTIR04
		SBC HL,DE
		LD A,(HL)
		INC HL
		EXX
		LD (HL),A
		INC HL
		EXX
		LD A,(HL)
		INC HL
		EXX
		LD (HL),A
		INC HL
		DEC BC
		LD A,B
		OR C
		EXX
		JR Z,SORTIR07
		ADD HL,DE
		JR SORTIR02

SORTIR04	INC HL
		INC HL
		EXX
		DEC BC
		LD A,B
		OR C
		EXX
		JR NZ,SORTIR02
SORTIR07	EXX
		LD BC,(FATVAR.KOLFIND)
		EXX
		LD HL,CPU3+0x1000
		INC BC
		LD A,(BC)
		AND A
		JR NZ,SORTIR02
		LD HL,CPU3+0x2000
		LD DE,CPU3
		LD BC,0x1000
		LDIR
		RET
